"""Rank-N-Contrast (RNC) losses for the CSPQ preference encoder.

RNC 用于连续标签的对比表示学习：
- 标准连续标签 RNC：让偏好排名接近的样本在隐空间靠近；
- cross-scene RNC：强制 free-drive 与 car-follow 中相同排名的样本靠近，避免形成两个
  独立隐空间（CSPQ 跨场景统一的关键监督）。
- 置信度加权：rank_confidence 只给标量回归与 RNC 加权；不用于 L_axis（轴冲突是
  高维表示要保留的信息，按 valid_mask 监督即可）。

数值稳定性：logsumexp 归一化 + 空配对/空样本保护。
"""

from __future__ import annotations

from typing import Tuple

import torch
import torch.nn.functional as F


def _safe_masked_mean(loss: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
    """带掩码安全均值：无效位置贡献 0，除数为有效数；无有效时返回 0。"""
    denom = mask.float().sum()
    if denom <= 0:
        return loss.new_zeros(())
    return (loss * mask.float()).sum() / denom


def rnc_loss(z: torch.Tensor, rank: torch.Tensor, confidence: torch.Tensor,
             *, temperature: float = 0.1, scene_id: torch.Tensor | None = None,
             cross_scene: bool = False) -> Tuple[torch.Tensor, float]:
    """连续标签 RNC（同场景）；cross_scene=True 时跨场景构造正对。

    Args:
        z: [B, D] 归一化隐向量。
        rank: [B] 连续偏好排名（[0,1]）。
        confidence: [B] 样本置信度（[0,1]）。
        temperature: 对比温度。
        scene_id: [B] 场景 id（cross_scene=False 时仅同场景配对）。
        cross_scene: 是否跨场景构造正对（CSPQ 关键）。

    Returns:
        (loss, 有效配对数)。
    """
    if z.shape[0] < 2:
        return z.new_zeros(()), 0.0
    sim = z @ z.T / temperature  # [B, B]
    eye = torch.eye(sim.shape[0], device=sim.device, dtype=torch.bool)
    pair_mask = torch.ones_like(sim, dtype=torch.bool)
    if scene_id is not None and not cross_scene:
        pair_mask = scene_id.unsqueeze(0) == scene_id.unsqueeze(1)
    pair_mask = pair_mask & ~eye

    conf = confidence.clamp_min(0.0)
    conf_weight = conf.unsqueeze(1) * conf.unsqueeze(0)

    rank_dist = (rank.unsqueeze(1) - rank.unsqueeze(0)).abs()  # [B, B]
    span = rank_dist.max().clamp_min(1e-6)
    pos_weight = torch.exp(-rank_dist / span) * conf_weight

    median_dist = rank_dist[rank_dist > 0].median().clamp_min(1e-6)
    neg_mask = (rank_dist > median_dist) & pair_mask & ~eye

    anchor_batch = sim.shape[0]
    losses = torch.zeros(anchor_batch, device=z.device)
    valid_anchors = 0
    for i in range(anchor_batch):
        pos_j = torch.nonzero(pair_mask[i] & ~eye[i]).squeeze(-1)
        if pos_j.numel() == 0:
            continue
        pos_weights_i = pos_weight[i, pos_j]
        topk = min(pos_j.numel(), 8)
        top_idx = torch.topk(pos_weights_i, topk).indices
        pos_j_top = pos_j[top_idx]
        pos_w_top = pos_weights_i[top_idx].clamp_min(1e-6)
        neg_k = torch.nonzero(neg_mask[i]).squeeze(-1)
        if neg_k.numel() == 0:
            continue
        num = (torch.exp(sim[i, pos_j_top]) * pos_w_top).sum()
        den = num + torch.exp(sim[i, neg_k]).sum()
        losses[i] = -torch.log(num / den.clamp_min(1e-12))
        valid_anchors += 1

    if valid_anchors == 0:
        return losses.sum(), 0.0
    return losses[:valid_anchors].mean(), float(valid_anchors)


def cross_scene_rnc_loss(z: torch.Tensor, rank: torch.Tensor, confidence: torch.Tensor,
                         *, temperature: float = 0.1) -> Tuple[torch.Tensor, float]:
    """跨场景 RNC：batch 内两场景各有样本，强制同排名样本跨场景靠近。"""
    return rnc_loss(z, rank, confidence, temperature=temperature, scene_id=None, cross_scene=True)


def rank_huber_loss(s: torch.Tensor, rank: torch.Tensor, confidence: torch.Tensor) -> torch.Tensor:
    """置信度加权的标量排序 Huber 损失：lambda_r * c * Huber(s, rank)。"""
    delta = F.smooth_l1_loss(s.squeeze(-1), rank, reduction="none")
    return (delta * confidence).mean() if confidence.sum() > 0 else delta.new_zeros(())


def axis_loss(q_hat: torch.Tensor, q_vec: torch.Tensor, valid_mask: torch.Tensor) -> torch.Tensor:
    """三因子百分位回归：按 valid_mask 监督，不用置信度 c 降权。"""
    diff = (q_hat - q_vec) ** 2
    return _safe_masked_mean(diff, valid_mask)


def encoder_total_loss(*, z: torch.Tensor, s: torch.Tensor, q_hat: torch.Tensor,
                       rank: torch.Tensor, q_vec: torch.Tensor, valid_mask: torch.Tensor,
                       confidence: torch.Tensor, scene_id: torch.Tensor,
                       temperature: float = 0.1, lambda_cross: float = 0.1,
                       lambda_r: float = 1.0, lambda_a: float = 1.0) -> dict:
    """CSPQ 总损失：L = RNC + lambda_x*cross-scene-RNC + lambda_r*c*Huber(s,r) + lambda_a*L_axis。

    Returns dict with keys: loss / rnc / cross_rnc / rank_loss / axis_loss / rnc_pairs / cross_pairs。
    """
    rnc, rnc_pairs = rnc_loss(z, rank, confidence, temperature=temperature, scene_id=scene_id, cross_scene=False)
    cross, cross_pairs = cross_scene_rnc_loss(z, rank, confidence, temperature=temperature)
    rank_l = rank_huber_loss(s, rank, confidence)
    axis_l = axis_loss(q_hat, q_vec, valid_mask)
    total = rnc + lambda_cross * cross + lambda_r * rank_l + lambda_a * axis_l
    return {
        "loss": total,
        "rnc": rnc,
        "cross_rnc": cross,
        "rank_loss": rank_l,
        "axis_loss": axis_l,
        "rnc_pairs": rnc_pairs,
        "cross_pairs": cross_pairs,
    }